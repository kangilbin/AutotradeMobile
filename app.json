{
  "expo": {
    "name": "오토스윙",
    "slug": "autoTradeApp",
    "scheme": "autoTradeApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4ECDC4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.my.autotradeapp"
    },
    "android": {
      "package": "com.my.autotradeapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#3DBDB2"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4ECDC4"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56570574-4b7b-4cfb-bd3d-985f1c0fe17a"
      }
    }
  }
}
